{
  "pluginAlias": "NavienSmart",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "authMode": {
        "title": "Auth Mode",
        "type": "string",
        "default": "account",
        "oneOf": [
          {
            "title": "Navien Smart Account",
            "enum": [ "account" ]
          },
          {
            "title": "Token",
            "enum": [ "token" ]
          }
        ],
        "required": true
      },
      "username": {
        "title": "Username",
        "type": "string"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "condition": {
          "functionBody": "return model.authMode === 'account';"
        }
      },
      "refreshToken": {
        "title": "Refresh Token",
        "type": "string",
        "condition": {
          "functionBody": "return model.authMode === 'token';"
        }
      },
      "accountSeq": {
        "title": "Account Seq",
        "type": "number",
        "condition": {
          "functionBody": "return model.authMode === 'token';"
        }
      },
      "accessoryType": {
        "title": "Accessory Type",
        "type": "string",
        "default": "HeaterCooler",
        "oneOf": [
          {
            "title": "Heater",
            "enum": [ "HeaterCooler" ]
          },
          {
            "title": "Thermostat",
            "enum": [ "Thermostat" ]
          }
        ],
        "required": true
      },
      "separateControl": {
        "title": "Separate Control",
        "type": "boolean",
        "default": false
      },
      "displayName": {
        "title": "Display Name",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "device": {
              "title": "Device Name in Navien Smart App",
              "type": "string"
            },
            "mainSwitch": {
              "title": "Main Switch Name",
              "type": "string"
            },
            "left": {
              "title": "Left Controller Name",
              "type": "string"
            },
            "right": {
              "title": "Right Controller Name",
              "type": "string"
            }
          },
          "required": [ "device" ]
        },
        "condition": {
          "functionBody": "return model.separateControl;"
        }
      }
    }
  }
}