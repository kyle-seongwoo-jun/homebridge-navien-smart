{
  "private": false,
  "displayName": "Navien Smart",
  "name": "homebridge-navien-smart",
  "version": "1.7.2",
  "description": "Homebridge plugin to control Navien devices via Navien Smart",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/kyle-seongwoo-jun/homebridge-navien-smart#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyle-seongwoo-jun/homebridge-navien-smart.git"
  },
  "bugs": {
    "url": "https://github.com/kyle-seongwoo-jun/homebridge-navien-smart/issues"
  },
  "engines": {
    "node": "^18.17.0 || ^20.9.0 || ^22.11.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "bin": {
    "navien": "./bin/navien"
  },
  "scripts": {
    "lint": "eslint src/**/*.ts --max-warnings=0 --fix",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepublishOnly": "npm run lint && npm run build",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "postinstall": "patch-package"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "dependencies": {
    "@aws-amplify/pubsub": "^6.1.31",
    "aws-amplify": "^6.8.0",
    "fetch-cookie": "^3.0.1",
    "node-fetch": "^3.3.2",
    "node-persist": "^4.0.3",
    "patch-package": "^8.0.0",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.2",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.14.0",
    "@stylistic/eslint-plugin": "^2.10.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.9.0",
    "@types/node-fetch": "^3.0.3",
    "@types/node-persist": "^3.1.8",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.12.0",
    "homebridge": "^2.0.0-beta.0",
    "homebridge-config-ui-x": "^4.62.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}